# =====================================
# 営業管理ダッシュボード 環境変数
# =====================================

# --- Google 認証 ---
GOOGLE_OAUTH_CREDENTIALS=~/.config/sales-dashboard/credentials.json
GOOGLE_OAUTH_TOKEN=~/.config/sales-dashboard/token.json

# --- 担当者 ---
# シート上の表記そのままで書く
OWNER_NAME=松戸
SUBORDINATE_NAME=

# --- スプレッドシート ---
# シートID（URL の /d/ と /edit の間の文字列）
SHEET_ID_OWNER=
SHEET_ID_SUBORDINATE=

# シート（タブ）名
# YOMI_SHEET_NAME_TEMPLATE で {name} を担当者名に置換可能（推奨）
# 例: 松戸_ヨミ表_顧客管理 / 鈴木_ヨミ表_顧客管理
YOMI_SHEET_NAME_TEMPLATE={name}_ヨミ表_顧客管理

# 個別指定が必要な場合のみ設定（テンプレートを上書き）
# YOMI_SHEET_NAME_OWNER=松戸_ヨミ表_顧客管理
# YOMI_SHEET_NAME_SUBORDINATE=鈴木_ヨミ表_顧客管理

# 列見出し行は自動検出（顧客名ヘッダーを探す）。検出できない時のフォールバックのみ
HEADER_ROW=5

# 分析タブ（自動集計）。ダッシュボード表示用に読み込む
ANALYSIS_SHEET_NAME_TEMPLATE={name}_ヨミ表_分析

# --- 列マッピング（列レター。スクショ確認済の値） ---
COL_CUSTOMER=B
COL_LEAD_STATUS=C
COL_INFLOW=D
COL_FIRST_APPT_DATE=H
COL_FIRST_APPT_DONE=I
COL_FIRST_APPT_FORECAST=J
COL_SECOND_APPT_DATE=S
COL_SECOND_APPT_DONE=T
COL_SECOND_APPT_FORECAST=U
COL_CURRENT_STATUS=W
COL_LOST_REASON=O
COL_NA_MEMO=V
COL_CONTRACT_PLANNED_DATE=Y
COL_CONTRACT_DATE=Z
COL_CONTRACT_PLAN=AA
COL_CONTRACT_AMOUNT_INCLUSIVE=AB
COL_CONTRACT_AMOUNT_EXCLUSIVE=AC
COL_CLOSED_DATE=AK
COL_CLOSED_AMOUNT_INCLUSIVE=AN

# --- Google Calendar ---
CALENDAR_ID_OWNER=primary
CALENDAR_ID_SUBORDINATE=

# 商談識別キーワード（タイトルにいずれか含めば営業活動として扱う）
ACTIVITY_KEYWORDS=無料カウンセリング,商談,アポ,訪問,面談,初回,2回目,契約

# --- LINE 通知 ---
LINE_CHANNEL_ACCESS_TOKEN=
# グループ送信を使う場合（推奨: 2人以上のチームならグループ1つにまとめる）
# C で始まる Group ID を貼り付け。設定されていれば USER_ID より優先される
LINE_GROUP_ID=
# 個別送信のフォールバック用。グループ運用なら未設定でOK
LINE_USER_ID_OWNER=
LINE_USER_ID_SUBORDINATE=

# --- メール通知（フォールバック） ---
NOTIFY_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- 警告ロジック設定 ---
STAGNANT_STATUSES=検討中,長期追客,2回目商談日程確定,2回目商談日程調整中
EXCLUDED_EVENT_KEYWORDS=キャンセル,再アポ,契約予定,契約
ALIASES_PATH=
MISSING_LOG_DATE_TOLERANCE_DAYS=1

# --- 動作パラメータ ---
NOTIFICATION_HOUR=9
STAGNANT_DAYS_THRESHOLD=7
TIMEZONE=Asia/Tokyo
